diff --git a/src/app/pages/daily-summary/estimate-overruns.spec.ts b/src/app/pages/daily-summary/estimate-overruns.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3c31475f4bb93c254230fdb011009a85a46aa799
--- /dev/null
+++ b/src/app/pages/daily-summary/estimate-overruns.spec.ts
@@ -0,0 +1,30 @@
+import { DEFAULT_TASK, Task } from '../../features/tasks/task.model';
+import { estimateOverruns } from './estimate-overruns';
+
+describe('Estimate overruns', () => {
+  const minute = 60_000;
+  const task = (id: string, estimate: number, actual: number): Task => ({
+    ...DEFAULT_TASK,
+    id,
+    projectId: 'demo',
+    timeEstimate: estimate * minute,
+    timeSpent: actual * minute,
+  });
+
+  it('includes the boundary, sorts by overrun and breaks ties by ID', () => {
+    const input = [task('b', 30, 60), task('a', 15, 45), task('big', 30, 90)];
+    expect(estimateOverruns(input).map(({ task: row }) => row.id)).toEqual([
+      'big',
+      'a',
+      'b',
+    ]);
+    expect(input[0].id).toBe('b');
+  });
+
+  it('excludes unknown estimates, parent totals, and differences below the threshold', () => {
+    const parent = { ...task('parent', 10, 90), subTaskIds: ['child'] };
+    expect(
+      estimateOverruns([parent, task('no-estimate', 0, 80), task('short', 30, 59)]),
+    ).toEqual([]);
+  });
+});
diff --git a/src/app/pages/daily-summary/estimate-overruns.ts b/src/app/pages/daily-summary/estimate-overruns.ts
new file mode 100644
index 0000000000000000000000000000000000000000..336a89a7d70139e15ed339fa3682a6c71294982a
--- /dev/null
+++ b/src/app/pages/daily-summary/estimate-overruns.ts
@@ -0,0 +1,15 @@
+import { Task } from '../../features/tasks/task.model';
+
+const minimumOverrun = 30 * 60 * 1000;
+
+export interface EstimateOverrun {
+  task: Task;
+  overrun: number;
+}
+
+export const estimateOverruns = (tasks: readonly Task[]): EstimateOverrun[] =>
+  tasks
+    .filter((task) => !task.subTaskIds?.length && task.timeEstimate > 0)
+    .map((task) => ({ task, overrun: task.timeSpent - task.timeEstimate }))
+    .filter(({ overrun }) => overrun >= minimumOverrun)
+    .sort((a, b) => b.overrun - a.overrun || a.task.id.localeCompare(b.task.id));
